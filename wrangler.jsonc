// wrangler.jsonc: how Cloudflare runs the RHEMA app.
// One Worker serves the built screens (web/out) and answers /api/ itself.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhema-hospital",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "web/out",
    "binding": "ASSETS",
    // Unknown screen addresses fall back to the app, so a refresh never 404s.
    "not_found_handling": "single-page-application",
    // Only /api/ goes to the Worker code. Every screen file is served free.
    "run_worker_first": ["/api/*"],
  },
  // The free workers.dev address, used until the domain moves on 6 November.
  "workers_dev": true,
  "observability": { "enabled": true },
}
