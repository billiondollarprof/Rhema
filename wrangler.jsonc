// wrangler.jsonc: how Cloudflare runs the RHEMA app.
// One Worker serves the built screens (web/out) and answers /api/ itself.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhema-hospital",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "web/out",
    "binding": "ASSETS",
    // Unknown screen addresses fall back to the app, so a refresh never 404s.
    "not_found_handling": "single-page-application",
    // Only /api/ goes to the Worker code. Every screen file is served free.
    "run_worker_first": ["/api/*"],
  },
  // Request 152: live answers on the hospital's own address. Cloudflare
  // makes its DNS record and certificate itself. The free workers.dev
  // address stays on, so the push alerts saved in the database (which
  // still point at workers.dev) keep working until they are moved.
  "workers_dev": true,
  "routes": [{ "pattern": "rhemamedical.app", "custom_domain": true }],
  "observability": { "enabled": true },
  // Lab result files (request 115). Live uses rhema-files; testing uses its
  // own bucket (below), which deletes its files after 7 days. The buckets
  // are private: files are reached only through worker/src/files.ts.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "rhema-files" }],
  // The testing site: its own Worker name and its own bucket, so nothing on
  // testing ever touches live files. Deployed with --env testing.
  "env": {
    "testing": {
      "name": "rhema-hospital-testing",
      // Request B (6 November list): testing answers on the hospital's own
      // address. Cloudflare makes its DNS record and certificate itself.
      // The workers.dev address stays on too, so nothing breaks meanwhile.
      "workers_dev": true,
      "routes": [{ "pattern": "testing.rhemamedical.app", "custom_domain": true }],
      "observability": { "enabled": true },
      "assets": {
        "directory": "web/out",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "rhema-files-testing" }],
    },
  },
}
